FROM node:22-bookworm-slim AS build
WORKDIR /app

ARG VITE_API_URL
ARG VITE_PROVER_URL
ARG VITE_MONAD_RPC_URL
ARG VITE_MONAD_HISTORY_RPC_URL
ARG VITE_MONAD_EXPLORER_URL
ARG VITE_COVEN_REGISTRY_ADDRESS
ARG VITE_COVEN_REGISTRY_DEPLOYMENT_BLOCK

ENV VITE_API_URL=${VITE_API_URL} \
  VITE_PROVER_URL=${VITE_PROVER_URL} \
  VITE_MONAD_RPC_URL=${VITE_MONAD_RPC_URL} \
  VITE_MONAD_HISTORY_RPC_URL=${VITE_MONAD_HISTORY_RPC_URL} \
  VITE_MONAD_EXPLORER_URL=${VITE_MONAD_EXPLORER_URL} \
  VITE_COVEN_REGISTRY_ADDRESS=${VITE_COVEN_REGISTRY_ADDRESS} \
  VITE_COVEN_REGISTRY_DEPLOYMENT_BLOCK=${VITE_COVEN_REGISTRY_DEPLOYMENT_BLOCK}

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/prover/package.json apps/prover/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci

COPY apps/web apps/web
RUN npm run build -w @coven/web

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app

COPY --from=build /app/apps/web/dist apps/web/dist
COPY apps/web/server.mjs apps/web/server.mjs

USER node
EXPOSE 8080
CMD ["node", "apps/web/server.mjs"]
