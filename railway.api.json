{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/Dockerfile.api",
    "watchPatterns": [
      "/apps/api/**",
      "/package.json",
      "/package-lock.json",
      "/Dockerfile.api",
      "/railway.api.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/ready",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "runtime": "V2"
  }
}
